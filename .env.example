# 复制为 .env 后按需修改（.env 中的变量会自动加载，前缀 NIC_OCR_）

NIC_OCR_OCR_ENGINE=paddle
NIC_OCR_OCR_LANG=en
NIC_OCR_PADDLE_USE_GPU=false
NIC_OCR_PADDLE_USE_ANGLE_CLS=true
# 0=沿用库默认值；请用同机基准比较 1/2/4 后再选择。
NIC_OCR_PADDLE_CPU_THREADS=0
# 未设置时沿用 PaddleOCR 默认值；需要测试时取消注释并设 true/false。
# NIC_OCR_PADDLE_ENABLE_MKLDNN=true
# 0=沿用 OpenCV 默认值；避免与 Paddle 线程总数超订。
NIC_OCR_OPENCV_THREADS=0
# repayment 二值 variant 的快速降噪；false 可回滚 NLM。
NIC_OCR_FAST_PREPROCESSING=true
# 单 worker 共享一个 predictor，默认一次完成一个 OCR 请求。
NIC_OCR_OCR_MAX_CONCURRENT_REQUESTS_PER_WORKER=1
# 分阶段耗时只写日志，不进入 API JSON。
NIC_OCR_STAGE_TIMING_LOG=false
# false=优化前 CDM 调用顺序，可用于同版本 A/B 或紧急回滚。
NIC_OCR_CDM_ADAPTIVE_EARLY_STOP=true

# 多语言姓名第二引擎（僧伽罗语/泰米尔语姓名，默认 tesseract）
# 需系统安装 tesseract-ocr 及语言包：apt install tesseract-ocr tesseract-ocr-sin tesseract-ocr-tam
# 设为 none 可关闭；第二引擎不可用时主流程不受影响（name_sinhala/name_tamil 返回 null）
NIC_OCR_NAME_OCR_ENGINE=tesseract
NIC_OCR_NAME_OCR_LANG=sin+tam
NIC_OCR_NAME_TESSERACT_PSM=6
NIC_OCR_TESSERACT_CMD=

# NIC 解码：nic366（修正固定366天日历，匹配真实出生日期，推荐）/ literal（按字面天数）
NIC_OCR_NIC_DAY_MODE=nic366
NIC_OCR_OLD_NIC_CENTURY=1900

NIC_OCR_HOST=0.0.0.0
NIC_OCR_PORT=8000
NIC_OCR_WORKERS=2
NIC_OCR_MAX_UPLOAD_BYTES=15728640

# 远程图片 URL 下载（POST /ocr_url）
NIC_OCR_URL_FETCH_TIMEOUT_SECONDS=10
# 生产建议保持 false：禁止服务端访问内网/私有地址（SSRF 防护）
NIC_OCR_URL_FETCH_ALLOW_PRIVATE_HOSTS=false
